# Line endings
* text=auto eol=lf
*.go text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sh text eol=lf
Makefile text eol=lf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary

# Generated / vendored — exclude from diff stats
**/testdata/**/*.json linguist-generated=true
**/testdata/**/*.golden linguist-generated=true

# Go module proxy artifacts
go.sum -diff
