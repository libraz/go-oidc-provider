# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
build/
dist/

# Test artifacts
*.test
*.out
coverage.txt
coverage.html
profile.out
testdata/.cache/

# Fuzz
testdata/fuzz/
**/testdata/fuzz/*/

# Go workspace files
go.work
go.work.sum

# Dependency directories
vendor/

# Environment / secrets — never commit
.env
.env.*
!.env.example
secrets/
*.key
*.pem
*.p12
*.pfx

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Tool caches
.golangci-cache/
.cache/

# Python bytecode (conformance harness is Python; pytest / runtime
# generates these next to the source files).
__pycache__/
*.pyc

# Generated docs
docs/godoc/

# Local override
local/
tmp/

# Conformance harness runtime artifacts. *.pem above already covers the
# generated cert material; these add the op-demo runtime files.
conformance/op-demo.pid
conformance/op-demo.log
conformance/op-demo.bin
conformance/certs/openssl.cnf
conformance/certs/truststore.jks
conformance/.plan-ids.json
conformance/baselines/*.json
conformance/render/

# Stray op-demo binaries. op-demo is its own module, so `go build .` from
# cmd/op-demo writes next to the source; the older root-relative path is
# kept because `go build ./cmd/op-demo` still lands there under a
# workspace. The supported flow goes through scripts/conformance.sh, which
# writes to conformance/op-demo.bin (already ignored above).
/op-demo
/cmd/op-demo/op-demo

# The tools/ entries are separate Go submodules whose binaries are built next
# to their source by `go build ./tools/<name>` (or by the reach / scenario-* /
# stability* / gates / failopen Makefile targets that exec them).
/tools/failopentool/failopentool
/tools/gatetool/gatetool
/tools/reachtool/reachtool
/tools/scenariotool/scenariotool
/tools/stabilitytool/stabilitytool

# The reference application builds its binary next to its source when run
# with `go build` from sample/ rather than through docker compose.
/sample/sample

# Examples do the same: `go build` inside examples/NN-slug/ drops a binary
# named after the directory, which is otherwise indistinguishable from a
# source file to git. The root-relative form covers `go build
# ./examples/NN-slug`, which writes the same name into the repository root.
/examples/*/[0-9][0-9]-*
/[0-9][0-9]-*

# Internal-only artefacts (kept locally, never committed). The OSS-facing
# documentation lives in README.md, CHANGELOG.md, SECURITY.md, NOTICE,
# and CONTRIBUTING.md. The entire backup/ tree is internal working
# material and not part of the published repository.
CLAUDE.md
.claude/
backup/
